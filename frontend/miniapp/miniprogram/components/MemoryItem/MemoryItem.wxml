<view class="memory-item {{isLast ? 'isLast' : ''}} {{isTouchLeft ? 'isTouchLeft' : ''}}">
  <view
    class="memory-body"
    bindtouchstart="touchStart"
    bindtouchmove="touchMove"
    bindtouchend="touchEnd"
    catchtap="bindEdit"
  >
    <view class="dot" style="background-color: {{dotColor}}; box-shadow: 0 2rpx 6rpx {{dotShadow}};"></view>
    <text class="time">{{data.recordTime}}</text>
    <view class="main">
      <view class="title-row">
        <view class="title">
          <text class="address-text">{{data.diaryAddress || ''}}</text>
          <view class="ai-tag">{{_i18n['memoryItem.aiTag']}}</view>
        </view>
      </view>

      <view class="content {{launch ? 'launch' : ''}}">
        <text class="content-text">{{data.recordText || ''}}</text>
      </view>

      <view wx:if="{{data.showMore}}" class="more">
        <view wx:if="{{launch}}" catchtap="doLaunch" class="btn">{{_i18n['memoryItem.collapse']}}</view>
        <view wx:else catchtap="doLaunch" class="btn">{{_i18n['memoryItem.expand']}}</view>
      </view>
    </view>
  </view>

  <view class="del-container {{isTouchLeft ? 'isTouchLeft' : ''}}" bindtap="del">
    <image class="del-icon" src="../../image/icon_del.png" mode="aspectFit" />
  </view>
</view>

<ConfirmDialog
  visible="{{confirmDialog.visible}}"
  title="{{confirmDialog.title || ''}}"
  content="{{confirmDialog.content || ''}}"
  cancelText="{{confirmDialog.cancelText || ''}}"
  confirmText="{{confirmDialog.confirmText || ''}}"
  confirmType="{{confirmDialog.confirmType}}"
  bind:cancel="onConfirmDialogCancel"
  bind:confirm="onConfirmDialogConfirm"
  bind:close="onConfirmDialogCancel"
/>
