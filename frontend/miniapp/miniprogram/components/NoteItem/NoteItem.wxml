
<view class="NoteItem">
  <view
    class="container {{isTouchLeft ? 'isTouchLeft' : ''}}"
    bindtouchstart="touchStart"
    bindtouchmove="touchMove"
    bindtouchend="touchEnd"
    bindtap="gotoDetail"
  >
    <view class="banner-wrap">
      <image
        src="{{data.coverImg || '../../image/default-bg.png'}}"
        mode="aspectFill"
        class="banner"
        lazy-load
      />
      <view class="banner-mask"></view>
      <view class="date-overlay">
        <view class="dayView">
          <view class="day">{{data.day}}</view>
          <view class="month">{{data.month}}</view>
        </view>
        <view class="weekDay">{{data.weekDayName}}</view>
      </view>
    </view>

    <view class="main">
      <view class="address-list" wx:if="{{data.familyMemberAddressConcatRecords.length}}">
        <view class="address-item" wx:for="{{data.familyMemberAddressConcatRecords}}" wx:key="index">
          <view class="item-line" style="background-color: {{data.dotColor}};"></view>
          <image mode="aspectFill" class="avatar" src="{{item.familyMemberAvatar || '../../image/logo.png'}}" lazy-load />
          <view class="address">{{item.familyMemberAddressConcat}}</view>
        </view>
      </view>
      <view wx:else class="empty-tip">{{_i18n['noteItem.noLocation']}}</view>
    </view>
  </view>

  <view class="del-container {{isTouchLeft ? 'isTouchLeft' : ''}}" bindtap="del">
    <image class="del-icon" src="../../image/icon_del.png" mode="aspectFit" />
  </view>
</view>

<ConfirmDialog
  visible="{{confirmDialog.visible}}"
  title="{{confirmDialog.title || ''}}"
  content="{{confirmDialog.content || ''}}"
  cancelText="{{confirmDialog.cancelText || ''}}"
  confirmText="{{confirmDialog.confirmText || ''}}"
  confirmType="{{confirmDialog.confirmType}}"
  bind:cancel="onConfirmDialogCancel"
  bind:confirm="onConfirmDialogConfirm"
  bind:close="onConfirmDialogCancel"
/>
